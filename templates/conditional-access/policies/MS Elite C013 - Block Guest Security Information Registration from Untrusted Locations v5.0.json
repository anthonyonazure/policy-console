{
  "displayName": "MS Elite | C013 - Block Guest Security Information Registration from Untrusted Locations v5.0",
  "state": "enabledForReportingButNotEnforced",
  "conditions": {
    "users": {
      "excludeGroups": [
        "${EMERGENCY_ACCESS_GROUP_ID}"
      ],
      "includeGuestsOrExternalUsers": {
        "externalTenants": {
          "@odata.type": "#microsoft.graph.conditionalAccessAllExternalTenants",
          "membershipKind": "all"
        },
        "guestOrExternalUserTypes": "internalGuest,b2bCollaborationGuest,b2bCollaborationMember,b2bDirectConnectUser,otherExternalUser,serviceProvider"
      }
    },
    "locations": {
      "excludeLocations": [
        "AllTrusted"
      ],
      "includeLocations": [
        "All"
      ]
    },
    "applications": {
      "includeUserActions": [
        "urn:user:registersecurityinfo"
      ]
    },
    "clientAppTypes": [
      "all"
    ]
  },
  "grantControls": {
    "operator": "OR",
    "builtInControls": [
      "block"
    ]
  }
}
