{
  "displayName": "MS Elite | C017 - Block Unmanaged Devices v5.1",
  "state": "enabledForReportingButNotEnforced",
  "conditions": {
    "users": {
      "excludeRoles": [
        "d29b2b05-8046-44ba-8758-1e26182fcf32"
      ],
      "includeUsers": [
        "All"
      ],
      "excludeGroups": [
        "${EMERGENCY_ACCESS_GROUP_ID}",
        "${SERVICE_ACCOUNTS_GROUP_ID}"
      ]
    },
    "devices": {
      "deviceFilter": {
        "mode": "exclude",
        "rule": "device.trustType -eq \"ServerAD\" -or device.trustType -eq \"AzureAD\" -or device.isCompliant -eq True"
      }
    },
    "applications": {
      "includeApplications": [
        "All"
      ]
    },
    "clientAppTypes": [
      "all"
    ]
  },
  "grantControls": {
    "operator": "OR",
    "builtInControls": [
      "block"
    ]
  }
}
