{
  "displayName": "MS Elite | C011 - Block Device Code Flow v5.1",
  "state": "enabledForReportingButNotEnforced",
  "conditions": {
    "users": {
      "includeUsers": [
        "All"
      ],
      "excludeGroups": [
        "${EMERGENCY_ACCESS_GROUP_ID}"
      ]
    },
    "applications": {
      "includeApplications": [
        "All"
      ]
    },
    "clientAppTypes": [
      "all"
    ],
    "authenticationFlows": {
      "transferMethods": "deviceCodeFlow"
    }
  },
  "grantControls": {
    "operator": "OR",
    "builtInControls": [
      "block"
    ]
  }
}
